APP_ENV=development
BASE_MODEL=garystafford/wav2vec2-deepfake-voice-detector
DATABASE_URL=sqlite:///./data/ghostvoice.db
STORAGE_DIR=./data/encrypted
VOICE_ENCRYPTION_KEY=REPLACE_ME
JWT_SECRET=REPLACE_ME
MAX_UPLOAD_MB=200
MAX_SECONDS=180
WINDOW_SECONDS=4
HOP_SECONDS=2
BASE_WEIGHT=0.85
SPECTRAL_WEIGHT=0.15
UNCERTAIN_LOW=0.30
UNCERTAIN_HIGH=0.70
ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
ACCESS_TOKEN_MINUTES=60
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ANALYZE=20/minute

# Password recovery / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=https://YOUR-HF-SPACE.hf.space
MAX_WINDOWS=30

# Comma-separated emails allowed to see the Admin Panel option
ADMIN_EMAILS=
