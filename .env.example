APP_ENV=development
BASE_MODEL=garystafford/wav2vec2-deepfake-voice-detector
DATABASE_URL=sqlite:///./data/ghostvoice.db
STORAGE_DIR=./data/encrypted
VOICE_ENCRYPTION_KEY=REPLACE_ME
JWT_SECRET=REPLACE_ME
MAX_UPLOAD_MB=25
MAX_SECONDS=60
WINDOW_SECONDS=4
HOP_SECONDS=2
BASE_WEIGHT=0.85
SPECTRAL_WEIGHT=0.15
UNCERTAIN_LOW=0.30
UNCERTAIN_HIGH=0.70
ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
ACCESS_TOKEN_MINUTES=60
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ANALYZE=20/minute
